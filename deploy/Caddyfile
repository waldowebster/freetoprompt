freetoprompt.com {
	root * /srv/freetoprompt/current
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), fullscreen=(self), screen-wake-lock=(self)"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-cache"
		-Server
	}
	file_server
}

www.freetoprompt.com {
	redir https://freetoprompt.com{uri} permanent
}
